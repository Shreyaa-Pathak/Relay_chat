# ---------------------------------------------------------------------------
# Relay server configuration. Copy to .env for local dev:  cp .env.example .env
# On Vercel, set the same variables in Project Settings -> Environment Variables.
# Never commit real values. The server validates these at startup and names
# any missing/invalid variable (values are never logged).
# ---------------------------------------------------------------------------

# Postgres connection string.
#   Local (docker compose): postgres://relay:relay@localhost:5432/relay
#   Neon: use the *pooled* connection string (host contains "-pooler"), with ?sslmode=require
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# Redis for cross-instance pub/sub and presence. Must be a TCP URL (SUBSCRIBE needs a held
# connection; Upstash's REST endpoint can't subscribe).
#   Local: redis://localhost:6379
#   Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379   (note rediss:// = TLS)
REDIS_URL=redis://localhost:6379

# Signs 15-minute access tokens. At least 32 characters. Generate: openssl rand -base64 48
# Rotating it signs everyone out of their current access token (refresh tokens are stored hashed in Postgres).
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Public origin of the app. Cookies get the Secure flag automatically when this is https://.
#   Local: http://localhost:5173      Vercel: https://<your-project>.vercel.app
APP_URL=http://localhost:5173

# Extra origins allowed to call the API / open WebSockets (comma-separated), e.g. a custom domain
# or a stable preview URL. APP_URL is always trusted.
TRUSTED_ORIGINS=

# Server closes each WebSocket after this long (ms); clients reconnect before it.
# Vercel Hobby functions stop at 300 s, so keep this below 300000.
WS_MAX_CONNECTION_MS=290000

# Local single-process dev without Redis ONLY. Refused when NODE_ENV=production.
RELAY_ALLOW_MEMORY_BUS=0

# Optional tuning
LOG_LEVEL=info
DB_POOL_MAX=5
REGISTER_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_MINUTE=10
# PORT=3001   # local dev server port
